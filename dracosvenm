----------------------------------------------------------------
-- 3. SISTEMA DE DETECÇÃO COMPARTILHADA (SEM CHAT)
----------------------------------------------------------------
-- Cria ou obtém uma pasta pública no ReplicatedStorage para os scripts se comunicarem
local networkFolder = ReplicatedStorage:FindFirstChild(SCRIPT_FOLDER_NAME)
if not networkFolder then
	local newFolder = Instance.new("Folder")
	newFolder.Name = SCRIPT_FOLDER_NAME
	newFolder.Parent = ReplicatedStorage
	networkFolder = newFolder
end

local function refreshUserList()
	for _, child in ipairs(userListContainer:GetChildren()) do
		if child:IsA("TextButton") then
			child:Destroy()
		end
	end

	local yOffset = 0
	for player, _ in pairs(activeUsers) do
		if player and player.Parent then
			local userBtn = Instance.new("TextButton")
			userBtn.Size = UDim2.new(1, -10, 0, 30)
			userBtn.Position = UDim2.new(0, 5, 0, yOffset)
			userBtn.BackgroundColor3 = (selectedTarget == player) and Color3.fromRGB(0, 120, 215) or Color3.fromRGB(50, 50, 50)
			userBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
			userBtn.Text = player.Name
			userBtn.TextSize = 13
			userBtn.Font = Enum.Font.SourceSans
			userBtn.Parent = userListContainer

			userBtn.MouseButton1Click:Connect(function()
				selectedTarget = player
				selectedLabel.Text = "Alvo: " .. player.Name
				refreshUserList()
			end)

			yOffset = yOffset + 35
		end
	end
	userListContainer.CanvasSize = UDim2.new(0, 0, 0, yOffset)
end

-- Registrar o próprio jogador criando um objeto na pasta compartilhada
local myUserMarker = Instance.new("StringValue")
myUserMarker.Name = LocalPlayer.Name
myUserMarker.Value = "ONLINE"
myUserMarker.Parent = networkFolder

-- Monitorar quem entra e sai na pasta compartilhada
networkFolder.ChildAdded:Connect(function(child)
	if child:IsA("StringValue") then
		local p = Players:FindFirstChild(child.Name)
		if p then
			activeUsers[p] = true
			refreshUserList()
		end
	end
end)

networkFolder.ChildRemoved:Connect(function(child)
	if child:IsA("StringValue") then
		local p = Players:FindFirstChild(child.Name)
		if p and p ~= LocalPlayer then
			activeUsers[p] = nil
			if selectedTarget == p then
				selectedTarget = nil
				selectedLabel.Text = "Alvo: Nenhum"
			end
			refreshUserList()
		end
	end
end)

-- Carregar quem já está na pasta ao iniciar
for _, child in ipairs(networkFolder:GetChildren()) do
	if child:IsA("StringValue") then
		local p = Players:FindFirstChild(child.Name)
		if p then
			activeUsers[p] = true
		end
	end
end

-- Sistema para receber comandos de Kill / Kick via atributos na pasta
networkFolder.AttributeChanged:Connect(function(attributeName)
	local data = networkFolder:GetAttribute(attributeName)
	if type(data) == "table" then
		if data.action == "KILL" and data.target == LocalPlayer.Name then
			local char = LocalPlayer.Character
			if char and char:FindFirstChild("Humanoid") then
				char.Humanoid.Health = 0
			end
		elseif data.action == "KICK" and data.target == LocalPlayer.Name then
			LocalPlayer:Kick(data.message or kickMessage)
		end
	end
end)

----------------------------------------------------------------
-- 4. CONTROLES E ATALHOS DE TECLADO
----------------------------------------------------------------
UserInputService.InputBegan:Connect(function(input, gameProcessed)
	-- Alt + W (Menu de Senha)
	if UserInputService:IsKeyDown(Enum.KeyCode.LeftAlt) or UserInputService:IsKeyDown(Enum.KeyCode.RightAlt) then
		if input.KeyCode == Enum.KeyCode.W then
			if not isUnlocked then
				loginFrame.Visible = not loginFrame.Visible
				if loginFrame.Visible then
					passwordBox.Text = ""
					passwordBox:CaptureFocus()
				end
			end
		end
	end

	-- Tecla K (Abrir/Fechar Menu Principal)
	if input.KeyCode == Enum.KeyCode.K and isUnlocked then
		mainFrame.Visible = not mainFrame.Visible
		if mainFrame.Visible then
			refreshUserList()
		end
	end
end)

-- Validação da Senha
passwordBox.FocusLost:Connect(function(enterPressed)
	if enterPressed then
		if passwordBox.Text == SCRIPT_PASSWORD then
			isUnlocked = true
			loginFrame.Visible = false -- Fecha o painel de senha de vez
			mainFrame.Visible = true    -- Abre o menu principal
			passwordBox.Text = ""
			refreshUserList()
		else
			passwordBox.Text = ""
			passwordBox.PlaceholderText = "Senha incorreta!"
			task.wait(1)
			passwordBox.PlaceholderText = "Digite a senha..."
		end
	end
end)

----------------------------------------------------------------
-- 5. AÇÕES DE KILL E KICK DIRETAS DO SCRIPT
----------------------------------------------------------------
killButton.MouseButton1Click:Connect(function()
	if selectedTarget then
		if selectedTarget == LocalPlayer then
			local char = LocalPlayer.Character
			if char and char:FindFirstChild("Humanoid") then
				char.Humanoid.Health = 0
			end
		else
			networkFolder:SetAttribute("Cmd_" .. math.random(1000, 9999), {
				action = "KILL",
				target = selectedTarget.Name
			})
		end
	end
end)

kickMsgBox.FocusLost:Connect(function()
	if kickMsgBox.Text ~= "" then
		kickMessage = kickMsgBox.Text
	end
end)

kickButton.MouseButton1Click:Connect(function()
	if selectedTarget then
		if selectedTarget == LocalPlayer then
			LocalPlayer:Kick(kickMessage)
		else
            networkFolder:SetAttribute("Cmd_" .. math.random(1000, 9999), {
				action = "KICK",
				target = selectedTarget.Name,
				message = kickMessage
			})
		end
	end
end)

refreshUserList()
