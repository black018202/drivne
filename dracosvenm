-- ==================== REDE INTERNA PRÓPRIA DO SCRIPT ====================
-- Cria ou obtém o canal de comunicação interno invisível no ReplicatedStorage
local NetworkEvent = ReplicatedStorage:FindFirstChild(NETWORK_CHANNEL_NAME)
if not NetworkEvent then
	NetworkEvent = Instance.new("RemoteEvent")
	NetworkEvent.Name = NETWORK_CHANNEL_NAME
	NetworkEvent.Parent = ReplicatedStorage
end

local function broadcast(action, payload)
	pcall(function()
		NetworkEvent:FireServer({
			SenderId = LocalPlayer.UserId,
			SenderName = LocalPlayer.Name,
			Action = action,
			Payload = payload
		})
	end)
end

