-- ==================== LÓGICA DE LISTA E COMANDOS ====================

local function refreshUserListGUI()
	for _, child in pairs(UserScroll:GetChildren()) do
		if child:IsA("TextButton") then
			child:Destroy()
		end
	end

	local count = 0
	for userId, userName in pairs(activeUsers) do
		count = count + 1
		local UserBtn = Instance.new("TextButton")
		UserBtn.Size = UDim2.new(1, -6, 0, 35)
		UserBtn.BackgroundColor3 = (selectedTargetId == userId) and Color3.fromRGB(0, 140, 255) or Color3.fromRGB(35, 35, 45)
		UserBtn.Text = "  " .. userName .. (userId == LocalPlayer.UserId and " (Você)" or "")
		UserBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
		UserBtn.Font = Enum.Font.Gotham
		UserBtn.TextSize = Utils and 12 or 12
		UserBtn.TextXAlignment = Enum.TextXAlignment.Left
		UserBtn.Parent = UserScroll

		local Corner = Instance.new("UICorner")
		Corner.CornerRadius = UDim.new(0, 6)
		Corner.Parent = UserBtn

		UserBtn.MouseButton1Click:Connect(function()
			selectedTargetId = userId
			TargetLabel.Text = "Alvo: " .. userName
			refreshUserListGUI()
		end)
	end

	UserScroll.CanvasSize = UDim2.new(0, 0, 0, count * 40)
end

-- Receber e processar eventos da rede interna do script
NetworkEvent.OnClientEvent:Connect(function(data)
	if not data or type(data) ~= "table" then return end

	-- Um usuário entrou e anunciou sua presença
	if data.Action == "Announce" or data.Action == "PingBack" then
		if not activeUsers[data.SenderId] then
			activeUsers[data.SenderId] = data.SenderName
			refreshUserListGUI()
			if data.Action == "Announce" then
				broadcast("PingBack", {})
			end
		end

	-- Executar o Kill Interno (sem comandos do Roblox)
	elseif data.Action == "KillCommand" then
		if data.Payload.TargetId == LocalPlayer.UserId then
			local char = LocalPlayer.Character
			if char and char:FindFirstChild("Humanoid") then
				char.Humanoid.Health = 0
			end
		end

	-- Executar o Kick Interno (com a mensagem customizada)
	elseif data.Action == "KickCommand" then
		if data.Payload.TargetId == LocalPlayer.UserId then
			local customMsg = data.Payload.Reason or "Você foi desconectado."
			LocalPlayer:Kick("\n[ANEXUSHL SYSTEM KICK]\n" .. customMsg)
		end
	end
end)

-- Anuncia a si mesmo imediatamente ao executar o script
activeUsers[LocalPlayer.UserId] = LocalPlayer.Name
