-- PARTE 3: DESCIDA COM PLATAFORMA (SISTEMA RAYFIELD)
-----------------------------------------------------------
local ativadoDescida = false
local plataformaGigante = nil
local connectionNoClip = nil
local DISTANCIA_DESCIDA = 25
local TAMANHO_PLATAFORMA = Vector3.new(2000, 2, 2000)

local function habilitarNoClip()
    connectionNoClip = RunService.Stepped:Connect(function()
        local character = LocalPlayer.Character
        if character and ativadoDescida then
            for _, part in pairs(character:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = false
                end
            end
        end
    end)
end

local function desabilitarNoClip()
    if connectionNoClip then
        connectionNoClip:Disconnect()
        connectionNoClip = nil
    end
    local character = LocalPlayer.Character
    if character then
        for _, part in pairs(character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = true
            end
        end
    end
end

local function criarPlataforma(posicaoY)
    local part = Instance.new("Part")
    part.Size = TAMANHO_PLATAFORMA
    part.CFrame = CFrame.new(0, posicaoY, 0)
    part.Anchored = true
    part.CanCollide = true
    part.Material = Enum.Material.SmoothPlastic
    part.Color = Color3.fromRGB(0, 170, 255)
    part.Transparency = 0.4
    part.Parent = workspace
    return part
end

local function alternarDescida(estado)
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return end
    local hrp = character.HumanoidRootPart

    if estado then
        ativadoDescida = true
        habilitarNoClip()
        hrp.CFrame = hrp.CFrame - Vector3.new(0, DISTANCIA_DESCIDA, 0)
        plataformaGigante = criarPlataforma(hrp.Position.Y - 3)
    else
        ativadoDescida = false
        desabilitarNoClip()
        if plataformaGigante then
            plataformaGigante:Destroy()
            plataformaGigante = nil
        end
        hrp.CFrame = hrp.CFrame + Vector3.new(0, DISTANCIA_DESCIDA, 0)
    end
end

TabMove:CreateToggle({
