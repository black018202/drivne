-- 3. SISTEMA DE COMUNICAÇÃO VIA CHAT DA REQUISICAO
----------------------------------------------------------------
local function refreshUserList()
	for _, child in ipairs(userListContainer:GetChildren()) do
		if child:IsA("TextButton") then
			child:Destroy()
		end
	end

	local yOffset = 0
	for player, _ in pairs(activeUsers) do
		if player and player.Parent then
			local userBtn = Instance.new("TextButton")
			userBtn.Size = UDim2.new(1, -10, 0, 30)
			userBtn.Position = UDim2.new(0, 5, 0, yOffset)
			userBtn.BackgroundColor3 = (selectedTarget == player) and Color3.fromRGB(0, 120, 215) or Color3.fromRGB(50, 50, 50)
			userBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
			userBtn.Text = player.Name
			userBtn.TextSize = 13
			userBtn.Font = Enum.Font.SourceSans
			userBtn.Parent = userListContainer

			userBtn.MouseButton1Click:Connect(function()
				selectedTarget = player
				selectedLabel.Text = "Alvo: " .. player.Name
				refreshUserList()
			end)

			yOffset = yOffset + 35
		end
	end
	userListContainer.CanvasSize = UDim2.new(0, 0, 0, yOffset)
end

activeUsers[LocalPlayer] = true

-- Função para enviar mensagem secreta de rede
local function sendNetworkMessage(msg)
	local fullMessage = PREFIX .. msg
	pcall(function()
		if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
			local generalChannel = TextChatService.TextChannels:FindFirstChild("RBXGeneral")
			if generalChannel then
				generalChannel:SendAsync(fullMessage)
			end
		else
			ReplicatedStorage.DefaultChatSystemChatEvents.SayMessageRequest:FireServer(fullMessage, "All")
		end
	end)
end

-- Processador de comandos recebidos dos outros clientes
local function processIncomingPayload(senderPlayer, payload)
	if not senderPlayer or senderPlayer == LocalPlayer then return end

	local args = string.split(payload, "|")
	local cmd = args[1]

	if cmd == "PING" or cmd == "HERE" then
		activeUsers[senderPlayer] = true
		refreshUserList()
		if cmd == "PING" then
			sendNetworkMessage("HERE")
		end
	elseif cmd == "KILL" then
		local targetName = args[2]
		if targetName == LocalPlayer.Name then
			local char = LocalPlayer.Character
			if char and char:FindFirstChild("Humanoid") then
				char.Humanoid.Health = 0
			end
		end
	elseif cmd == "KICK" then
		local targetName = args[2]
		local reason = args[3] or kickMessage
		if targetName == LocalPlayer.Name then
			LocalPlayer:Kick(reason)
		end
	end
end

-- Escutar o chat do jogo para identificar outros usuários do script
Players.PlayerChatted:Connect(function(chatType, senderPlayer, message)
	if string.sub(message, 1, #PREFIX) == PREFIX then
		local payload = string.sub(message, #PREFIX + 1)
		processIncomingPayload(senderPlayer, payload)
	end
end)

-- Tratar quando um jogador sai do servidor
Players.PlayerRemoving:Connect(function(player)
	if activeUsers[player] then
		activeUsers[player] = nil
		if selectedTarget == player then
			selectedTarget = nil
			selectedLabel.Text = "Alvo: Nenhum"
		end
		refreshUserList()
	end
end)

-- Ping constante para manter a lista de quem usa o script atualizada
task.spawn(function()
	task.wait(2)
	sendNetworkMessage("PING")
	while task.wait(5) do
		sendNetworkMessage("PING")
	end
end)

