-- ==================== EVENTOS DE INPUT E CONTROLE ====================

local function tryLogin()
	if PasswordInput.Text == PASSWORD_CORRECT then
		isAuthenticated = true
		LoginFrame.Visible = false
		MainFrame.Visible = true
		refreshUserListGUI()
	else
		PasswordInput.Text = ""
		PasswordInput.PlaceholderText = "Senha Incorreta! Tente novamente."
	end
end

LoginBtn.MouseButton1Click:Connect(tryLogin)
PasswordInput.FocusLost:Connect(function(enterPressed)
	if enterPressed then
		tryLogin()
	end
end)

-- Teclas de Atalho (Alt + W para login / K para abrir/fechar o painel principal)
UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end

	if input.KeyCode == Enum.KeyCode.W and UserInputService:IsKeyDown(Enum.KeyCode.LeftAlt) then
		if not isAuthenticated then
			LoginFrame.Visible = not LoginFrame.Visible
			if LoginFrame.Visible then
				PasswordInput:CaptureFocus()
			end
		end
	end

	if input.KeyCode == Enum.KeyCode.K then
		if isAuthenticated then
			MainFrame.Visible = not MainFrame.Visible
		end
	end
end)

-- Disparar Comando de Kill para o Alvo Selecionado
KillBtn.MouseButton1Click:Connect(function()
	if selectedTargetId then
		broadcast("KillCommand", { TargetId = selectedTargetId })
	end
end)

-- Disparar Comando de Kick com a Mensagem Customizada para o Alvo Selecionado
KickBtn.MouseButton1Click:Connect(function()
	if selectedTargetId then
		local reasonText = KickReasonBox.Text
		if reasonText == "" then reasonText = "Você foi desconectado." end
		broadcast("KickCommand", { TargetId = selectedTargetId, Reason = reasonText })
	end
end)
