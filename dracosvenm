-- PARTE 2: VELOCIDADE SEM DESLIZAR
-----------------------------------------------------------
local speedValue = 16
local isSpeedEnabled = false

getgenv().ConexaoVelocidade = RunService.RenderStepped:Connect(function()
    if isSpeedEnabled and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        local root = LocalPlayer.Character.HumanoidRootPart
        local humanoid = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        
        if humanoid then
            local moveDir = humanoid.MoveDirection
            if moveDir.Magnitude > 0 then
                root.AssemblyLinearVelocity = Vector3.new(moveDir.X * speedValue, root.AssemblyLinearVelocity.Y, moveDir.Z * speedValue)
            else
                root.AssemblyLinearVelocity = Vector3.new(0, root.AssemblyLinearVelocity.Y, 0)
            end
        end
    end
end)

