-- 3. DETECÇÃO E REDE ENTRE JOGADORES DO SCRIPT
----------------------------------------------------------------
local remoteEvent = ReplicatedStorage:FindFirstChild(COMMUNICATION_CHANNEL)
if not remoteEvent then
	local possibleEvent = Instance.new("RemoteEvent")
	possibleEvent.Name = COMMUNICATION_CHANNEL
	possibleEvent.Parent = ReplicatedStorage
	remoteEvent = possibleEvent
end

local function refreshUserList()
	for _, child in ipairs(userListContainer:GetChildren()) do
		if child:IsA("TextButton") then
			child:Destroy()
		end
	end

	local yOffset = 0
	for player, _ in pairs(activeUsers) do
		if player and player.Parent then
			local userBtn = Instance.new("TextButton")
			userBtn.Size = UDim2.new(1, -10, 0, 30)
			userBtn.Position = UDim2.new(0, 5, 0, yOffset)
			userBtn.BackgroundColor3 = (selectedTarget == player) and Color3.fromRGB(0, 120, 215) or Color3.fromRGB(50, 50, 50)
			userBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
			userBtn.Text = player.Name
			userBtn.TextSize = 13
			userBtn.Font = Enum.Font.SourceSans
			userBtn.Parent = userListContainer

			userBtn.MouseButton1Click:Connect(function()
				selectedTarget = player
				selectedLabel.Text = "Alvo: " .. player.Name
				refreshUserList()
			end)

			yOffset = yOffset + 35
		end
	end
	userListContainer.CanvasSize = UDim2.new(0, 0, 0, yOffset)
end

-- Incluir o próprio jogador na lista
activeUsers[LocalPlayer] = true

-- Tratar desconexão de jogadores
Players.PlayerRemoving:Connect(function(player)
	if activeUsers[player] then
		activeUsers[player] = nil
		if selectedTarget == player then
			selectedTarget = nil
			selectedLabel.Text = "Alvo: Nenhum"
		end
		refreshUserList()
	end
end)

-- Eventos do cliente
remoteEvent.OnClientEvent:Connect(function(action, senderName, targetData)
	local senderPlayer = Players:FindFirstChild(senderName)

	if action == "PING" or action == "ANNOUNCE" then
		if senderPlayer then
			activeUsers[senderPlayer] = true
			refreshUserList()
		end
	elseif action == "GET_USERS" then
		-- Alguém novo entrou, envia nossa presença de volta
		remoteEvent:FireServer("ANNOUNCE", LocalPlayer.Name)
	elseif action == "KILL" and targetData == LocalPlayer.Name then
		local char = LocalPlayer.Character
		if char and char:FindFirstChild("Humanoid") then
			char.Humanoid.Health = 0
		end
	elseif action == "KICK" and type(targetData) == "table" and targetData.target == LocalPlayer.Name then
		LocalPlayer:Kick(targetData.message or kickMessage)
	end
end)

-- Solicitar e responder presença na rede
task.spawn(function()
	task.wait(1)
	remoteEvent:FireServer("GET_USERS", LocalPlayer.Name)
	remoteEvent:FireServer("ANNOUNCE", LocalPlayer.Name)
	
	while task.wait(4) do
		remoteEvent:FireServer("PING", LocalPlayer.Name)
	end
end)

----------------------------------------------------------------
-- 4. CONTROLES E ATALHOS DE TECLADO
----------------------------------------------------------------
UserInputService.InputBegan:Connect(function(input, gameProcessed)
	-- Alt + W (Menu de Senha)
	if UserInputService:IsKeyDown(Enum.KeyCode.LeftAlt) or UserInputService:IsKeyDown(Enum.KeyCode.RightAlt) then
		if input.KeyCode == Enum.KeyCode.W then
			if not isUnlocked then
				loginFrame.Visible = not loginFrame.Visible
				if loginFrame.Visible then
					passwordBox.Text = ""
					passwordBox:CaptureFocus()
				end
			end
		end
	end

	-- Tecla K (Abrir/Fechar menu principal se já liberado pela senha)
	if input.KeyCode == Enum.KeyCode.K and isUnlocked then
		mainFrame.Visible = not mainFrame.Visible
		if mainFrame.Visible then
			refreshUserList()
		end
	end
end)

-- Validação de Senha no Enter
passwordBox.FocusLost:Connect(function(enterPressed)
	if enterPressed then
		if passwordBox.Text == SCRIPT_PASSWORD then
			isUnlocked = true
			loginFrame.Visible = false -- Oculta a caixa de senha
			mainFrame.Visible = true    -- Abre a interface principal
			passwordBox.Text = ""
			refreshUserList()
		else
			passwordBox.Text = ""
			passwordBox.PlaceholderText = "Senha incorreta!"
			task.wait(1)
			passwordBox.PlaceholderText = "Digite a senha..."
		end
	end
end)

----------------------------------------------------------------
-- 5. AÇÕES DE KILL E KICK
----------------------------------------------------------------
killButton.MouseButton1Click:Connect(function()
	if selectedTarget then
		if selectedTarget == LocalPlayer then
			local char = LocalPlayer.Character
			if char and char:FindFirstChild("Humanoid") then
				char.Humanoid.Health = 0
			end
		else
			remoteEvent:FireServer("KILL", LocalPlayer.Name, selectedTarget.Name)
		end
	end
end)

kickMsgBox.FocusLost:Connect(function()
	if kickMsgBox.Text ~= "" then
		kickMessage = kickMsgBox.Text
	end
end)

kickButton.MouseButton1Click:Connect(function()
	if selectedTarget then
		if selectedTarget == LocalPlayer then
			LocalPlayer:Kick(kickMessage)
		else
			remoteEvent:FireServer("KICK", LocalPlayer.Name, {
				target = selectedTarget.Name,
				message = kickMessage
			})
		end
	end
end)

refreshUserList()
