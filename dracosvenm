-- ==================== REDE & COMUNICAÇÃO INTERNA ====================

local function broadcast(action, payload)
	pcall(function()
		MessagingService:PublishAsync(NETWORK_TOPIC, {
			SenderId = LocalPlayer.UserId,
			SenderName = LocalPlayer.Name,
			Action = action,
			Payload = payload
		})
	end)
end

local function refreshUserListGUI()
	for _, child in pairs(UserScroll:GetChildren()) do
		if child:IsA("TextButton") then
			child:Destroy()
		end
	end

	local count = 0
	for userId, userName in pairs(activeUsers) do
		count = count + 1
		local UserBtn = Instance.new("TextButton")
		UserBtn.Size = UDim2.new(1, -8, 0, 30)
		UserBtn.BackgroundColor3 = (selectedTargetId == userId) and Color3.fromRGB(0, 120, 215) or Color3.fromRGB(45, 45, 50)
		UserBtn.Text = userName
		UserBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
		UserBtn.Font = Enum.Font.SourceSans
		UserBtn.TextSize = 14
		UserBtn.Parent = UserScroll

		local Corner = Instance.new("UICorner")
		Corner.CornerRadius = UDim.new(0, 4)
		Corner.Parent = UserBtn

		UserBtn.MouseButton1Click:Connect(function()
			selectedTargetId = userId
			TargetLabel.Text = "Alvo: " .. userName
			refreshUserListGUI()
		end)
	end

	UserScroll.CanvasSize = UDim2.new(0, 0, 0, count * 34)
end

-- Escutar mensagens de outros scripts na mesma rede
pcall(function()
	MessagingService:SubscribeAsync(NETWORK_TOPIC, function(message)
		local data = message.Data
		if not data or type(data) ~= "table" then return end

		-- Detectar anúncio de presença
		if data.Action == "Announce" then
			if not activeUsers[data.SenderId] then
				activeUsers[data.SenderId] = data.SenderName
				refreshUserListGUI()
				-- Responder para que o novo usuário também saiba que existimos
				broadcast("PingBack", {})
			end

		elseif data.Action == "PingBack" then
			if not activeUsers[data.SenderId] then
				activeUsers[data.SenderId] = data.SenderName
				refreshUserListGUI()
			end

		-- Receber ordens de Kill
		elseif data.Action == "KillCommand" then
			if data.Payload.TargetId == LocalPlayer.UserId then
				if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
					LocalPlayer.Character.Humanoid.Health = 0
				end
			end

		-- Receber ordens de Kick
		elseif data.Action == "KickCommand" then
			if data.Payload.TargetId == LocalPlayer.UserId then
				local msg = data.Payload.Reason or "Você foi desconectado."
				LocalPlayer:Kick("\n[PAINEL REMOTO]\n" .. msg)
			end
		end
	end)
end)

