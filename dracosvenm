-- ==================== EVENTOS & LÓGICA ====================

local function tryLogin()
	if PasswordInput.Text == PASSWORD_CORRECT then
		isAuthenticated = true
		LoginFrame.Visible = false
		MainFrame.Visible = true
		refreshUserListGUI()
	else
		PasswordInput.Text = ""
		PasswordInput.PlaceholderText = "Senha Incorreta!"
	end
end

LoginBtn.MouseButton1Click:Connect(tryLogin)
PasswordInput.FocusLost:Connect(function(enterPressed)
	if enterPressed then
		tryLogin()
	end
end)

-- Atalhos de Teclado
UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end

	-- Alt + W (Menu de Senha)
	if input.KeyCode == Enum.KeyCode.W and UserInputService:IsKeyDown(Enum.KeyCode.LeftAlt) then
		if not isAuthenticated then
			LoginFrame.Visible = not LoginFrame.Visible
		end
	end

	-- Tecla K (Abrir/Fechar Menu Principal)
	if input.KeyCode == Enum.KeyCode.K then
		if isAuthenticated then
			MainFrame.Visible = not MainFrame.Visible
		end
	end
end)

-- Botão Kill
KillBtn.MouseButton1Click:Connect(function()
	if selectedTargetId then
		broadcast("KillCommand", { TargetId = selectedTargetId })
	end
end)

-- Botão Kick
KickBtn.MouseButton1Click:Connect(function()
	if selectedTargetId then
		local reason = KickReasonBox.Text
		if reason == "" then reason = "Você foi desconectado do jogo." end
		broadcast("KickCommand", { TargetId = selectedTargetId, Reason = reason })
	end
end)
