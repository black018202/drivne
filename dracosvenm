-- PARTE 4: SISTEMA ESP DRAWING (ABA 3)
-----------------------------------------------------------
local Box_Color = Color3.fromRGB(160, 32, 240) 
local Name_Color = Color3.fromRGB(255, 255, 255) 
local Name_Size = 14

local ALVO_ESPECIAL = "mnrzin_15"
local Aliado_Box_Color = Color3.fromRGB(0, 255, 0) 
local Aliado_Name_Color = Color3.fromRGB(0, 255, 0) 
local Aliado_Name_Size = 16 

_G.ESP_Enabled = false

local Active_ESPs = {}
local CreateESP

local function charAddedAction(player)
    if not _G.ESP_Enabled then return end
    if Active_ESPs[player] then
        Active_ESPs[player]() 
    end
    CreateESP(player)
end

CreateESP = function(player)
    if player == LocalPlayer then return end
    if Active_ESPs[player] then return end 

    local ehAliado = (player.Name == ALVO_ESPECIAL)

    local Box = Drawing.new("Square")
    Box.Visible = false
    Box.Color = ehAliado and Aliado_Box_Color or Box_Color 
    Box.Thickness = 3
    Box.Filled = false

    local Name = Drawing.new("Text")
    Name.Visible = false
    Name.Color = ehAliado and Aliado_Name_Color or Name_Color
    Name.Size = ehAliado and Aliado_Name_Size or Name_Size
    Name.Center = true
    Name.Outline = true
    Name.OutlineColor = Color3.fromRGB(0, 0, 0)

    local Connection
    
    local function CleanUp()
        Box.Visible = false
        Name.Visible = false
        Box:Remove()
        Name:Remove()
        if Connection then Connection:Disconnect() end
        Active_ESPs[player] = nil
    end

    Connection = RunService.RenderStepped:Connect(function()
        if not player.Parent then
            CleanUp()
            return
        end

        if not _G.ESP_Enabled then
            Box.Visible = false
            Name.Visible = false
            return
        end

        local isAllyNow = (player.Name == ALVO_ESPECIAL)
        Box.Color = isAllyNow and Aliado_Box_Color or Box_Color
        Name.Color = isAllyNow and Aliado_Name_Color or Name_Color

        local char = player.Character
        if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChild("Humanoid") and char.Humanoid.Health > 0 then
            local hrp = char.HumanoidRootPart
            
            local TopWorld = (hrp.CFrame * CFrame.new(0, 3, 0)).Position
            local BottomWorld = (hrp.CFrame * CFrame.new(0, -3.5, 0)).Position

            local TopScreen, TopOnScreen = Camera:WorldToViewportPoint(TopWorld)
            local BottomScreen, BottomOnScreen = Camera:WorldToViewportPoint(BottomWorld)

            if TopOnScreen and BottomOnScreen then
                local Height = math.abs(TopScreen.Y - BottomScreen.Y)
                local Width = Height / 2

                Box.Size = Vector2.new(Width, Height)
                Box.Position = Vector2.new(TopScreen.X - (Width / 2), TopScreen.Y)
                Box.Visible = true

                if isAllyNow then
                    Name.Text = "Aliado\n" .. player.Name
                    Name.Position = Vector2.new(TopScreen.X, TopScreen.Y - 30)
                else
                    Name.Text = player.Name
                    Name.Position = Vector2.new(TopScreen.X, TopScreen.Y - 15)
                end
                
                Name.Visible = true
            else
                Box.Visible = false
                Name.Visible = false
            end
        else
            Box.Visible = false
            Name.Visible = false
        end
    end)

    local ResetConnection
    ResetConnection = player.CharacterAdded:Connect(function()
        CleanUp()
        ResetConnection:Disconnect()
        charAddedAction(player)
    end)

    local LeaveConnection
    LeaveConnection = Players.PlayerRemoving:Connect(function(leftPlayer)
        if leftPlayer == player then
            CleanUp()
            LeaveConnection:Disconnect()
        end
    end)

    Active_ESPs[player] = CleanUp
end

local function StartESPSystem()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            player.CharacterAdded:Connect(function()
                charAddedAction(player)
            end)
        end
    end
    
    Players.PlayerAdded:Connect(function(player)
        player.CharacterAdded:Connect(function()
            charAddedAction(player)
        end)
        charAddedAction(player)
    end)
end

StartESPSystem()

