-- PARTE 1: AUTO ATTACK (ALVO FIXO + OFFSET SÓ SE ANDAR)
-----------------------------------------------------------
local autoAttackActive = false
local currentTween = nil
local TWEEN_SPEED = 38
local lockedTarget = nil
local OFFSET_STUDS = 2 -- Alterado para 2 studs como padrão

local function getClosestPlayer()
    local closestPlayer = nil
    local shortestDistance = math.huge
    local myChar = LocalPlayer.Character
    if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return nil end
    local myPos = myChar.HumanoidRootPart.Position
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") and player.Character:FindFirstChildOfClass("Humanoid").Health > 0 then
            local dist = (player.Character.HumanoidRootPart.Position - myPos).Magnitude
            if dist < shortestDistance then 
                shortestDistance = dist 
                closestPlayer = player 
            end
        end
    end
    return closestPlayer
end

local function equipBat()
    local character = LocalPlayer.Character
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if not character or not backpack then return end
    for _, item in pairs(character:GetChildren()) do
        if item:IsA("Tool") and (item.Name:lower():find("bast") or item.Name:lower():find("bat")) then return item end
    end
    for _, item in pairs(backpack:GetChildren()) do
        if item:IsA("Tool") and (item.Name:lower():find("bast") or item.Name:lower():find("bat")) then
            item.Parent = character
            return item
        end
    end
end

local function startAutoAttack()
    lockedTarget = getClosestPlayer()
    
    task.spawn(function()
        while autoAttackActive and lockedTarget and getgenv().AutoAttackRodando do
            if lockedTarget.Character and lockedTarget.Character:FindFirstChild("HumanoidRootPart") and lockedTarget.Character:FindFirstChildOfClass("Humanoid").Health > 0 then
                local myChar = LocalPlayer.Character
                if myChar and myChar:FindFirstChild("HumanoidRootPart") then
                    equipBat()
                    
                    local targetHRP = lockedTarget.Character.HumanoidRootPart
                    local targetHumanoid = lockedTarget.Character:FindFirstChildOfClass("Humanoid")
                    local targetCFrame = targetHRP.CFrame
                    
                    -- Se o alvo estiver andando, aplica a distância configurada no slider (OFFSET_STUDS)
                    if targetHumanoid and targetHumanoid.MoveDirection.Magnitude > 0 then
                        targetCFrame = targetHRP.CFrame * CFrame.new(0, 0, -OFFSET_STUDS)
                    end
                    
                    local distance = (targetCFrame.Position - myChar.HumanoidRootPart.Position).Magnitude
                    local tweenTime = distance / TWEEN_SPEED
                    local tweenInfo = TweenInfo.new(tweenTime, Enum.EasingStyle.Linear)
                    
                    currentTween = TweenService:Create(myChar.HumanoidRootPart, tweenInfo, {CFrame = targetCFrame})
                    currentTween:Play()
                    
                    VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
                    task.wait(0.05)
                    VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
                end
            else
                break
            end
            task.wait(0.1)
        end
        
        if currentTween then currentTween:Cancel() end
    end)
end

TabCombat:CreateToggle({
